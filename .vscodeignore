# Files left out of the packaged vsix. vsce runs `vscode:prepublish`
# (copy:media + compile) BEFORE applying these rules, so ignoring the sources
# and scripts here does not affect the build.
#
# Keep: out/** (compiled extension), media/** (webview shells + media/vendor),
# vendor/**, package.json, README.md, LICENSE, and node_modules (vsce adds the
# production dependencies; `npm run package:verify` checks ajv is present).

.baiton/**
.claude/**
.vscode/**
.vscode-test/**
src/**
test/**
scripts/**
*.vsix
tsconfig.json
.mocharc.json
.eslintrc.json
.gitignore
**/*.map
